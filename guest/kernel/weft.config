# Weft Sandboxes additions to Firecracker's x86_64 microVM guest config.
#
# build.sh merges this fragment over the vendored Firecracker configuration
# and fails if `make olddefconfig` drops or changes any line below, so every
# setting here is guaranteed to be in the built kernel.

# Identify the build in `uname -r`.
CONFIG_LOCALVERSION="-weft"
# CONFIG_LOCALVERSION_AUTO is not set

# Everything is built in. Sandbox root filesystems come from arbitrary OCI
# images and never carry modules for this kernel.
# CONFIG_MODULES is not set

# The host passes the guest's static address on the kernel command line
# (ip=169.254.0.21::169.254.0.22:255.255.255.252::eth0:off). No DHCP.
CONFIG_IP_PNP=y
# CONFIG_IP_PNP_DHCP is not set
# CONFIG_IP_PNP_BOOTP is not set
# CONFIG_IP_PNP_RARP is not set

# Fresh randomness in every sandbox restored from a shared snapshot.
# Firecracker always exposes a VMGenID device (through ACPI on x86_64) and
# changes its identifier on every restore; the kernel reseeds its CRNG when
# it sees the change. virtio-rng (the Firecracker entropy device) feeds host
# entropy into the pool on top of that.
CONFIG_ACPI=y
CONFIG_VMGENID=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y

# Firecracker's devices, the serial console and the root filesystem.
CONFIG_KVM_GUEST=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_EXT4_FS=y

# weft-guest-init mounts devtmpfs, tmpfs, devpts and a cgroup v2 hierarchy.
CONFIG_DEVTMPFS=y
CONFIG_TMPFS=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_FREEZER=y

# Container tooling inside sandboxes commonly needs overlayfs.
CONFIG_OVERLAY_FS=y

# envd: PTYs for terminals, inotify for filesystem watches, and the event
# primitives the Go runtime relies on.
CONFIG_UNIX98_PTYS=y
CONFIG_INOTIFY_USER=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_FHANDLE=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_UNIX=y
CONFIG_INET=y
