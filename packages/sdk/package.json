{
  "name": "@weftsh/sandbox",
  "version": "0.1.0",
  "description": "Weft Sandboxes SDK helpers and admin CLI. Use the unmodified E2B SDK for sandboxes; use this package to configure it and to manage teams, keys, egress policies and templates.",
  "license": "Apache-2.0",
  "homepage": "https://weftsh.github.io/sandy/",
  "bugs": "https://github.com/Weftsh/sandy/issues",
  "keywords": ["e2b", "sandbox", "ai-agents", "code-interpreter", "firecracker", "microvm", "self-hosted", "aws"],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "weft-sandbox": "dist/cli.js"
  },
  "files": ["dist", "src", "README.md", "LICENSE"],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Weftsh/sandy.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
